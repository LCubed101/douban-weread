# Feishu bot
# Create your own Feishu app/bot and keep these values private.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Douban
# Full Cookie header exported from your own logged-in browser session.
# Authenticated write actions currently require at least dbcl2 and ck.
# Never commit the real value or paste it into issues/chat logs.
DOUBAN_COOKIE=

# WeRead official Agent API
# Obtain your own user-bound key from https://weread.qq.com/r/weread-skills
# Keep it local and never commit or paste it into logs/issues.
WEREAD_API_KEY=

# Storage
DATABASE_URL=sqlite:///data/douban-weread.db
