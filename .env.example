# Interaction interface
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Douban
# Full Cookie header exported from your own logged-in browser session.
# Authenticated write actions currently require at least dbcl2 and ck.
# Never commit the real value or paste it into issues/chat logs.
DOUBAN_COOKIE=

# WeRead
WEREAD_COOKIE=

# Optional vision / LLM provider
OPENAI_API_KEY=

# Storage
DATABASE_URL=sqlite:///data/douban-weread.db
